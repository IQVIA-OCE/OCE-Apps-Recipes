{
  "name": "OCEPlugin",
  "description": "APCR",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "oce-apps-scripts start-ios",
    "build": "oce-apps-scripts build-ios",
    "build-web": "oce-apps-scripts build-web",
    "start-web": "oce-apps-scripts start-web",
    "test": "jest"
  },
  "dependencies": {
    "@babel/core": "^7.0.0",
    "@oce-apps/apollo-react-native": "alpha",
    "@oce-apps/oce-apps-bridges": "alpha",
    "@oce-apps/oce-apps-scripts": "alpha",
    "@react-native/metro-config": "0.80.2",
    "@react-navigation/core": "6.4.17",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/stack": "6.4.1",
    "@reduxjs/toolkit": "1.7.1",
    "@testing-library/jest-native": "5.4.1",
    "@testing-library/react-hooks": "8.0.1",
    "@testing-library/react-native": "12.6.1",
    "babel-preset-expo": "12.0.11",
    "formik": "2.2.9",
    "jest": "29.7.0",
    "jest-file-snapshot": "0.3.8",
    "luxon": "2.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.80.2",
    "react-native-gesture-handler": "2.18.1",
    "react-native-keyboard-aware-scroll-view": "0.9.5",
    "react-native-linear-gradient": "2.8.3",
    "react-native-screens": "3.36.0",
    "react-native-vector-icons": "6.4.2",
    "react-native-web": "0.19.12",
    "react-redux": "7.2.6",
    "react-test-renderer": "19.1.0",
    "yup": "0.32.11"
  },
  "jest": {
    "preset": "react-native",
    "collectCoverageFrom": [
      "App.{js,jsx}",
      "src/**/*.{js,jsx}",
      "!<rootDir>/node_modules/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!react-native|@react-native|victory-*|@react-native-community|@oce-apps/apollo-react-native|react-navigation|@react-navigation|react-native-gesture-handler|@oce-apps/oce-apps-bridges|nanoid)"
    ],
    "setupFiles": [
      "./node_modules/@oce-apps/oce-apps-bridges/lib/setupMocks.js",
      "./node_modules/react-native-gesture-handler/jestSetup.js"
    ],
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ]
  }
}
