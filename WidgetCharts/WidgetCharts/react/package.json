{
  "name": "OCEPlugin",
  "description": "Sales Chart Widget",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "oce-apps-scripts build-ios",
    "build-web": "oce-apps-scripts build-web",
    "start": "oce-apps-scripts start-ios",
    "start-web": "oce-apps-scripts start-web",
    "test": "jest"
  },
  "dependencies": {
    "@babel/core": "^7.0.0",
    "@testing-library/react-native": "12.6.1",
    "@oce-apps/apollo-react-native": "alpha",
    "babel-preset-expo": "12.0.11",
    "color": "4.2.3",
    "jest": "29.7.0",
    "jest-file-snapshot": "0.3.8",
    "moment": "2.24.0",
    "@oce-apps/oce-apps-bridges": "alpha",
    "@oce-apps/oce-apps-scripts": "alpha",
    "react": "19.1.0",
    "react-native": "0.80.2",
    "react-native-vector-icons": "6.4.2",
    "react-test-renderer": "19.1.0",
    "@react-native/metro-config": "0.75.2",
    "react-native-web": "0.19.12",
    "react-dom": "19.1.0"
  },
  "jest": {
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!react-native|@react-native|victory-*|@react-native-community|@oce-apps/apollo-react-native|@oce-apps/oce-apps-bridges|nanoid)"
    ],
    "collectCoverageFrom": [
      "App.{js,jsx}",
      "src/**/*.{js,jsx}",
      "!<rootDir>/node_modules/"
    ],
    "setupFiles": [
      "./node_modules/@oce-apps/oce-apps-bridges/lib/setupMocks.js",
      "./__mocks__/EnvironmentData.js",
      "./__mocks__/sf/sfnetapi.js"
    ],
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-native": "4.0.11"
  }
}
