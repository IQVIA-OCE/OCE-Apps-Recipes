{
  "name": "OCEPlugin",
  "description": "Plan Cycle Summary",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "oce-apps-scripts build-ios",
    "build-web": "oce-apps-scripts build-web",
    "start": "oce-apps-scripts start-ios",
    "start-web": "oce-apps-scripts start-web",
    "test": "jest"
  },
  "dependencies": {
    "@babel/core": "^7.0.0",
    "@oce-apps/apollo-react-native": "alpha",
    "@oce-apps/oce-apps-bridges": "alpha",
    "@oce-apps/oce-apps-scripts": "alpha",
    "@react-native/metro-config": "0.75.2",
    "@reduxjs/toolkit": "1.7.1",
    "@testing-library/react-native": "12.6.1",
    "jest": "29.7.0",
    "jest-file-snapshot": "0.5.0",
    "luxon": "3.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.80.2",
    "react-native-vector-icons": "6.4.2",
    "react-native-web": "0.19.12",
    "react-redux": "9.1.0",
    "react-test-renderer": "19.1.0",
    "victory": "37.3.6",
    "victory-core": "37.3.6",
    "victory-native": "37.3.6"
  },
  "devDependencies": {
    "babel-preset-expo": "12.0.11"
  },
  "jest": {
    "preset": "react-native",
    "collectCoverageFrom": [
      "App.{js,jsx}",
      "src/**/*.{js,jsx}",
      "!<rootDir>/node_modules/",
      "!<rootDir>/bridge/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!@react-native|react-native|victory-*|@react-native-community|@oce-apps/apollo-react-native|@oce-apps/oce-apps-bridges|react-redux|nanoid)"
    ],
    "setupFiles": [
      "./node_modules/@oce-apps/oce-apps-bridges/lib/setupMocks.js",
      "./jest.setup.js"
    ]
  }
}
