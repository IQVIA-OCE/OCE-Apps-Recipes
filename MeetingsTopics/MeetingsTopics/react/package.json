{
  "name": "OCEPlugin",
  "description": "Meeting Topics",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "oce-apps-scripts build-ios",
    "start": "oce-apps-scripts start-ios",
    "test": "jest"
  },
  "dependencies": {
    "@babel/core": "^7.0.0",
    "@oce-apps/apollo-react-native": "alpha",
    "@oce-apps/oce-apps-bridges": "alpha",
    "@oce-apps/oce-apps-scripts": "alpha",
    "@react-native/metro-config": "0.75.2",
    "@reduxjs/toolkit": "1.6.1",
    "@testing-library/jest-native": "4.0.2",
    "@testing-library/react-hooks": "7.0.1",
    "@testing-library/react-native": "12.6.1",
    "babel-preset-expo": "12.0.11",
    "jest": "29.7.0",
    "luxon": "2.0.1",
    "react": "19.1.0",
    "react-native": "0.80.2",
    "react-native-gesture-handler": "2.18.1",
    "react-native-screens": "3.34.0",
    "react-native-vector-icons": "6.4.2",
    "react-redux": "7.2.4",
    "react-test-renderer": "19.1.0"
  },
  "jest": {
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!react-native|@react-native|victory-*|@react-native-community|@oce-apps/apollo-react-native|react-navigation|@react-navigation|react-native-gesture-handler|@oce-apps/oce-apps-bridges|nanoid)"
    ],
    "collectCoverageFrom": [
      "App.{js,jsx}",
      "src/**/*.{js,jsx}",
      "!<rootDir>/node_modules/"
    ],
    "coveragePathIgnorePatterns": [
      "validationSchema.js"
    ],
    "setupFiles": [
      "./node_modules/react-native-gesture-handler/jestSetup.js",
      "./node_modules/@oce-apps/oce-apps-bridges/lib/setupMocks.js",
      "./__mocks__/EnvironmentData.js",
      "./__mocks__/LayoutBridge.js",
      "./mockUseInit.js"
    ],
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ]
  },
  "devDependencies": {
    "prettier": "2.3.2"
  }
}
